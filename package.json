{
  "name": "hr-par-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "esbuild src/test/verifyAllSstRules.ts --bundle --platform=node | node",
    "deploy": "npm run build && cp dist/index.html dist/404.html && (REMOTE_URL=$(git remote get-url origin) && cd dist && git init && git branch -M gh-pages && git add -A && git commit -m 'deploy to gh-pages' && git push -f \"$REMOTE_URL\" gh-pages && rm -rf .git)"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  }
}
