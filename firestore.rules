rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in with a verified district (or NFPS partner-school) Google account.
    // Must match ALLOWED_SIGN_IN_DOMAINS in src/config/firebase.ts.
    function isDistrictStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@(ssttx[.]org|newfrontierspublicschools[.]org)$');
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Must match BOOTSTRAP_ADMIN_EMAILS in src/config/firebase.ts.
    function isBootstrapAdmin() {
      return isDistrictStaff() && myEmail() in ['kdemirci@ssttx.org', 'sstpar@ssttx.org'];
    }

    function myAccountPath() {
      return /databases/$(database)/documents/accounts/$(myEmail());
    }

    // Has an active portal account (created by an admin).
    function hasPortalAccount() {
      return isDistrictStaff() && exists(myAccountPath()) && get(myAccountPath()).data.active == true;
    }

    function isAdmin() {
      return isBootstrapAdmin() || (hasPortalAccount() && get(myAccountPath()).data.isAdmin == true);
    }

    // Portal accounts (who can sign in, and their role). Staff can read the directory
    // and their own account; only admins create or change accounts.
    match /accounts/{accountEmail} {
      allow read: if hasPortalAccount() || isAdmin() || (isDistrictStaff() && accountEmail == myEmail());
      allow write: if isAdmin();
    }

    // Daily ADP staff roster: readable by portal account holders, written only by the Cloud Function.
    match /adpRoster/{docId} {
      allow read: if hasPortalAccount() || isAdmin();
      allow write: if false;
    }

    function myAccount() {
      return get(myAccountPath()).data;
    }

    // HR, Payroll, Benefits, Regional Executive Directors, the CPO, and admins see all pay.
    function canSeeAllSalaries() {
      return isAdmin() || (hasPortalAccount() &&
        myAccount().get('canReviewStages', []).hasAny(['hr_review', 'payroll_action', 'benefits_review', 'cpo_review', 'regional_review']));
    }

    // A campus endorser (e.g. a principal) sees pay only for staff at their own campus.
    function isEndorserFor(campus) {
      return hasPortalAccount() &&
        myAccount().get('canReviewStages', []).hasAny(['supervisor_review']) &&
        myAccount().get('campus', '') != '' &&
        myAccount().get('campus', '') == campus;
    }

    // Staff pay from ADP, one record per employee; written only by the Cloud Function.
    match /adpSalaries/{associateOID} {
      allow get: if canSeeAllSalaries() || isEndorserFor(resource.data.campus);
      allow list: if canSeeAllSalaries();
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
